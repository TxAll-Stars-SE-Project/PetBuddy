PORT=5000
NODE_ENV=development

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
JWT_EXPIRES_IN_REMEMBER_ME="30d"


DATABASE_URL="postgresql://postgres.[project ID ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[project ID ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"