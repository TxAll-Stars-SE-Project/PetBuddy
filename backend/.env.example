# Database Connection (Supabase Transaction & Session Poolers)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Server Configuration
PORT=5000
NODE_ENV=development

# Mail Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="\"PetBuddy\" your-email@gmail.com"

# Supabase Configuration
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="petbuddy-images"

# Authentication & Tokens
JWT_SECRET="your-complex-jwt-secret-key"
JWT_EXPIRES_IN="1d"
JWT_EXPIRES_IN_REMEMBER_ME="30d"
PASSWORD_RESET_TOKEN_TTL_MINUTES="15"

# Frontend Application
FRONTEND_URL="http://localhost:5173"