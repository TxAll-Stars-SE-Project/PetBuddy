# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-URIJS-19963961:
    - 'eslint > ajv > uri-js':
        reason: >-
          Dev-only: eslint > ajv@6 > uri-js. uri-js is abandoned and has no
          fixed release; eslint only uses it to validate its own config schema,
          never on user input. Re-check when eslint drops ajv@6.
        expires: 2027-05-15T00:00:00.000Z
        created: 2026-11-15T06:11:08.313Z
