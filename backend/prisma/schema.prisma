generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model USER {
  userid      Int        @id @default(autoincrement())
  username    String     @unique @db.VarChar(50)
  password    String     @db.VarChar(100)
  email       String     @unique @db.VarChar(100)
  tel         String?    @db.VarChar(10)
  province    String?    @db.VarChar(50)
  city        String?    @db.VarChar(50)
  postal_code String?    @db.VarChar(10)
  petowner    petowner?
  petsitter   petsitter?
}

model booking {
  bookingid     Int             @id @default(autoincrement())
  ownerid       Int
  sitterid      Int?
  bookingdate   DateTime        @db.Timestamp(6)
  bookingstatus String          @db.VarChar(50)
  petowner      petowner        @relation(fields: [ownerid], references: [userid], onDelete: Cascade, onUpdate: NoAction)
  petsitter     petsitter?      @relation(fields: [sitterid], references: [userid], onDelete: Cascade, onUpdate: NoAction)
  bookingdetail bookingdetail[]
  payment       payment[]
  review        review[]
}

model bookingdetail {
  bookingid Int
  noteid    Int
  note      String
  booking   booking @relation(fields: [bookingid], references: [bookingid], onDelete: Cascade, onUpdate: NoAction)

  @@id([bookingid, noteid])
}

model payment {
  paymentid   Int     @id @default(autoincrement())
  bookingid   Int
  amount      Decimal @db.Decimal(10, 2)
  paymenttype String  @db.VarChar(50)
  booking     booking @relation(fields: [bookingid], references: [bookingid], onDelete: Cascade, onUpdate: NoAction)
}

model pet {
  ownerid  Int
  name     String   @db.VarChar(50)
  b_date   DateTime @db.Date
  allergy  String?
  gender   String?  @db.VarChar(20)
  weight   Decimal? @db.Decimal(5, 2)
  species  String?  @db.VarChar(50)
  breed    String?  @db.VarChar(50)
  petowner petowner @relation(fields: [ownerid], references: [userid], onDelete: Cascade, onUpdate: NoAction)

  @@id([ownerid, name, b_date])
}

model petowner {
  userid  Int       @id
  booking booking[]
  pet     pet[]
  USER    USER      @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction)
  report  report[]
}

model petsitter {
  userid     Int        @id
  thaiid     String     @unique @db.VarChar(13)
  experience String?
  booking    booking[]
  USER       USER       @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction)
  report     report[]
  services   services[]
}

model report {
  reportid      Int       @id @default(autoincrement())
  ownerid       Int
  sitterid      Int
  report_detail String?   @db.VarChar(200)
  petowner      petowner  @relation(fields: [ownerid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_report_owner")
  petsitter     petsitter @relation(fields: [sitterid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_report_sitter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model review {
  reviewid      Int     @id @default(autoincrement())
  bookingid     Int
  review_detail String? @db.VarChar(200)
  review_score  Int?
  booking       booking @relation(fields: [bookingid], references: [bookingid], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_booking")
}

model services {
  serviceid   Int       @id @default(autoincrement())
  userid      Int
  servicetype String    @db.VarChar(100)
  servicename String    @db.VarChar(255)
  petsitter   petsitter @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction)
}
